<div class="card-header-right flex items-center flex-shrink-0">
    {{#if cardData.pillLabel}}
        <span class="text-sm text-gray-600 mr-2">{{cardData.pillLabel}}:</span>
    {{/if}}
    {{#if cardData.pillText}}
        <span
            class="{{cardData.pillColor}} px-2 py-1 rounded-full text-sm font-semibold" 
            data-field="score">
            {{cardData.pillText}}
        </span>
    {{/if}}
</div>
