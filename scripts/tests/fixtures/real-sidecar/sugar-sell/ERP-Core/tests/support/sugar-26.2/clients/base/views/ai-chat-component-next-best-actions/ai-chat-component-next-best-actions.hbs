<div class="rounded-lg bg-white overflow-hidden">
    <div class="py-4 bg-gray-50 dark:bg-gray-900">
        <div class="grid gap-1 px-4">
            {{#each items}}
                {{#if separator}}
                    <div class="w-full border-t border-gray-300 [&&&&&&&&]:my-4"></div>
                {{else}}
                    <div
                        class="flex items-center gap-1 h-[34px] px-4 border border-[--pill-border] rounded-full bg-[--pill-background]
                            font-medium text-[13px] leading-none
                            {{#unless disabled}}hover:bg-blue-50 dark:hover:bg-blue-700 cursor-pointer{{/unless}}
                             transition-colors {{#if disabled}}text-gray-400 dark:hover:text-gray-100{{else}}text-[--pill-action] dark:hover:text-gray-200{{/if}} pill-button min-w-0 max-w-fit"
                        title="{{text}}"
                        {{#unless disabled}}data-action="next-best-action"{{/unless}}
                        data-text="{{text}}"
                        data-description="{{description}}"
                        data-longDescription="{{longDescription}}"
                        data-module="{{module}}">
                        {{#if icon}}
                            {{#if disabled}}
                                {{moduleLabel icon 'sm' class='[&&&&&&&&&&]:rounded-full mr-1 bg-gray-300'}}
                            {{else}}
                                {{moduleLabel icon 'sm' class='[&&&&&&&&&&]:rounded-full mr-1'}}
                            {{/if}}
                        {{/if}}
                        <span class="truncate min-w-0">{{text}}</span>
                        {{#if disabled}}
                            <div class="sicon sicon-check-circle-lg text-green-600"></div>
                        {{/if}}
                    </div>
                {{/if}}
            {{/each}}
        </div>
    </div>
</div>
