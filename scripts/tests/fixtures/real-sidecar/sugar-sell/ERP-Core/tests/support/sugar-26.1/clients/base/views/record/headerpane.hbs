<div class="headerpane bg-[--foreground-base] box-border fixed">
    <h1>
        {{#each view.meta.panels}}
            {{#if header}}
                {{#each grid}}
                    {{#each this}}
                        <span class="record-cell" data-type="{{type}}" data-name="{{name}}">
                            <span class="table-cell-wrapper">
                                {{#if ../../labels}}
                                    {{#unless dismiss_label}}
                                        <span class="record-label" data-name="{{name}}">{{str label ../../../../../../view.module}}</span>
                                    {{/unless}}
                                {{/if}}
                                <span class="index{{index}}" data-fieldname="{{name}}" data-index="{{index}}">
                                    {{field ../../../../view model=../../../../view.model template=../../../../view.action}}
                                </span>
                                {{#unless ../../../../view.createMode}}
                                    {{#notHas name ../../../../../view.noEditFields}}
                                        <span class="record-edit-link-wrapper" data-name="{{name}}" data-wrapper="edit">
                                            <a class="record-edit-link btn btn-invisible" data-type="{{type}}" data-name="{{name}}">
                                                <i class="sicon sicon-edit" aria-hidden=“true”></i>
                                            </a>
                                        </span>
                                        <span class="record-lock-link-wrapper hide" data-name="{{name}}">
                                            <a class="record-lock-link btn btn-invisible" data-type="{{type}}" data-name="{{name}}">
                                                <i class="sicon sicon-lock" aria-hidden=“true” rel="tooltip" data-original-title="{{str 'LBL_LOCKED_FIELD_RECORD_VIEW_TOOLTIP'}}" data-bs-placement="right"></i>
                                            </a>
                                        </span>
                                    {{/notHas}}
                                {{/unless}}
                            </span>
                        </span>
                    {{/each}}
                {{/each}}
            {{/if}}
        {{/each}}
        {{#if view.enableHeaderButtons}}
            <div class="btn-toolbar btn-toolbar-flex pull-right h-full items-center">
                {{#unless view.createMode}}
                    {{#if view.showPrevNextBtnGroup}}
                        <div class="btn-group btn-group-previous-next">
                            <button class="btn btn-invisible previous-row{{#unless view.showPrevious}} disabled{{/unless}}"
                                    data-action="scroll" data-action-type="prev"
                                    data-id="{{fieldValue view.model "id"}}" rel="tooltip" data-bs-placement="bottom" title="{{str "LNK_LIST_PREVIOUS" view.module}}"{{#unless view.showPrevious}} tabindex="-1"{{else}} tabindex="0"{{/unless}} aria-label="{{str "LNK_LIST_PREVIOUS" view.module}}">
                                <i class="sicon sicon-chevron-left rtl:-scale-x-100"></i>
                            </button>
                            <button class="btn btn-invisible next-row{{#unless view.showNext}} disabled{{/unless}}"
                                    data-action="scroll" data-action-type="next"
                                    data-id="{{fieldValue view.model "id"}}" rel="tooltip" data-bs-placement="bottom" title="{{str "LNK_LIST_NEXT" view.module}}"{{#unless view.showNext}} tabindex="-1"{{else}} tabindex="0"{{/unless}}  aria-label="{{str "LNK_LIST_NEXT" view.module}}">
                                <i class="sicon sicon-chevron-right rtl:-scale-x-100"></i>
                            </button>
                        </div>
                    {{/if}}
                {{/unless}}
                {{#each view.meta.actionButtons}}
                    {{#if decodedOptions.settings.showInRecordHeader}}
                        {{field ../../view}}
                    {{/if}}
                {{/each}}
                {{#each view.meta.buttons}}
                    {{field ../view}}
                {{/each}}
            </div>
        {{/if}}
    </h1>
</div>
