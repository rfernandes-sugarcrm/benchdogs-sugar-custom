<div class="card-header-left flex items-center flex-1 min-w-0">
    {{#if cardData.icon}}
        <div class="mr-2 flex-shrink-0">
            {{moduleLabel cardData.icon 'sm' class='mr-1'}}
        </div>
    {{/if}}
    <span class="text-gray-800 dark:text-gray-200 text-base font-semibold min-w-0 flex-1 truncate ellipsis_inline"
          data-field="title"
          data-bs-original-title="{{cardData.titleTooltip}}"
          data-bs-placement="bottom">
        {{{replaceWithLinks cardData.title.text cardData.title.meta}}}
    </span>
</div>
