<a {{#if fullRoute}}{{#unless externalRoute}}href="#{{/unless}}{{fullRoute}}"{{else}}{{#if def.route}}href="#{{buildRoute context=context model=model action=def.route.action}}"{{/if}}{{/if}}
{{#if openWindow}}
    target="_blank"
{{/if}}
    class="btn{{#if def.primary}} btn-primary{{/if}}"
{{#if def.tooltip}}
    rel="tooltip"
    data-bs-placement="bottom"
    title="{{str def.tooltip module}}"
{{/if}}
    {{#if ariaLabel}}aria-label="{{ariaLabel}}"{{/if}}
   role="button" tabindex="{{tabIndex}}" name="{{name}}" track="click:{{name}}"
    {{#unless fullRoute}}
        data-key-action="press"
    {{/unless}}
>
    {{#if def.icon}}
        <i class="{{buildIcon def.icon}}" aria-hidden="true"></i>
    {{/if}}
    {{label}}
</a>
