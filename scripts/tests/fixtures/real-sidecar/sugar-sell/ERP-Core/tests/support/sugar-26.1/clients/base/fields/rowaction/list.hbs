<a {{#if fullRoute}}href="#{{fullRoute}}"{{else}}{{#if def.route}}href="#{{buildRoute context=context model=model action=def.route.action}}"{{/if}}{{/if}}
    class="rowaction{{#if def.button}} btn{{/if}}{{#if def.primary}} btn-primary{{/if}}" data-key-action="press"
{{#if def.event}}
    data-event="{{def.event}}"
{{/if}}
{{#if def.tooltip}}
    rel="tooltip"
    data-bs-placement="bottom"
    title="{{str def.tooltip module}}"
{{/if}}
    {{#if ariaLabel}}aria-label="{{ariaLabel}}"{{/if}}
    role="button" tabindex="{{tabIndex}}" name="{{name}}" track="click:{{#if name}}{{name}}{{else}}{{label}}{{/if}}">
    {{#if def.tooltip}}
        {{#if def.icon}}
            <i class="{{buildIcon def.icon}}"></i>
        {{/if}}
    {{/if}}
    {{#unless def.dismiss_label}}
        {{str label}}
    {{/unless}}
</a>
