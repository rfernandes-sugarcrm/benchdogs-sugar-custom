{{~#if this.def.isMultiSelect~}}
    {{#if value}}
        {{#if ellipsis}}
            <div class="ellipsis_inline" data-bs-placement="bottom"
                 title="{{#each value}}{{#eachOptions ../items}}{{#eq key ../this}}{{#notEq @index 0}}, {{/notEq}}{{value}}{{/eq}}{{/eachOptions}}{{/each}}">
        {{/if}}
        {{#each value}}{{#eachOptions ../items}}{{#eq key ../this}}{{#notEq @index 0}}, {{/notEq}}{{value}}{{/eq}}{{/eachOptions}}{{/each}}
        {{#if ellipsis}}
            </div>
        {{/if}}
    {{/if}}
    {{else~}}
    {{#if value~}}
        {{#eachOptions items~}}
            {{#eq this.key ../value~}}
                {{#if ../../ellipsis~}}
                    <div class="flex">
                    <div class="ellipsis_inline{{#if ../../../formatting}} rounded-full px-2 py-1 flex gap-1{{/if}}" data-bs-placement="bottom" title="{{value}}"
                         {{#if ../../../formatting}}style="{{#if
                             ../../../../styles.backgroundColor}}background-color: {{../../../../../styles.backgroundColor}};{{/if~}}"{{/if}}
                    >
                {{/if~}}
                {{#if ../../formatting}}
                    {{#if ../../../styles.icon.class}}
                        <i style="color: {{../../../../styles.icon.color}}" aria-hidden="true"
                           class="sicon sicon-{{../../../../styles.icon.class}}"></i>
                    {{/if}}
                {{/if}}
                <div {{#if ../../formatting}}style="
                    {{#if ../../../styles.text.color}}color: {{../../../../styles.text.color}};{{/if}}
                    text-decoration: {{#if ../../../styles.text.isLineThrough}}line-through {{/if}}
                    {{#if ../../../styles.text.isUnderline}}underline {{/if}};"{{/if}}

                    class="ellipsis_inline text-overflow
                        {{#if ../../formatting}}{{#if ../../../styles.text.isBold}}font-bold {{/if~}}
                        {{#if ../../../styles.text.isItalic}}italic {{/if~}}{{/if}}"
                >
                   {{value~}}
                </div>
                {{#if ../ellipsis~}}
                        </div>
                    </div>
                {{/if~}}
            {{/eq~}}
        {{/eachOptions~}}
    {{/if~}}
{{/if~}}
