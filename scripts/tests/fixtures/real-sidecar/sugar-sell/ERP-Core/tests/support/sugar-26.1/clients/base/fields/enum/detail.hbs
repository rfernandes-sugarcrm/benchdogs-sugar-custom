{{#if this.def.isMultiSelect}}
    {{#if value}}
        <div class="ellipsis_inline" data-bs-placement="bottom" title="{{#each value}}{{#eachOptions ../items}}{{#eq key ../this}}{{#notEq @index 0}}, {{/notEq}}{{value}}{{/eq}}{{/eachOptions}}{{/each}}">{{#each value}}{{#eachOptions ../items}}{{#eq key ../this}}{{#notEq @index 0}}, {{/notEq}}{{value}}{{/eq}}{{/eachOptions}}{{/each}}</div>
    {{/if}}
{{else}}
    {{#if value includeZero=true}}
        {{#eachOptions items}}
            {{#eq this.key ../value}}
                {{#if ../../formatting}}
                    {{#with ../../../styles}}
                        <div class="flex">
                            <div
                                class="ellipsis_inline rounded-full px-2 py-1 flex gap-1"
                                style="{{#if backgroundColor}}background-color: {{backgroundColor}};{{/if}}display: inline-flex !important;"
                                data-bs-placement="bottom" title="{{../value}}"
                            >
                                {{#if icon.class}}
                                    <i class="sicon sicon-{{icon.class}}" style="color: {{icon.color}};"></i>
                                {{/if}}
                                <div
                                    class="ellipsis_inline text-overflow {{#if text.isBold}}font-bold {{/if}}{{#if text.isItalic}}italic{{/if}}"
                                    style="{{#if text.color}}color: {{text.color}};{{/if}} text-decoration: {{#if text.isLineThrough}}line-through {{/if}}{{#if text.isUnderline}}underline{{/if}};"
                                >{{../value}}</div>
                            </div>
                        </div>
                    {{/with}}
                {{else}}
                    <div class="ellipsis_inline" data-bs-placement="bottom" title="{{../value}}">
                        <div class="w-fit inline-block">{{../value}}</div>
                    </div>
                {{/if}}
            {{/eq}}
        {{/eachOptions}}
    {{/if}}
{{/if}}
