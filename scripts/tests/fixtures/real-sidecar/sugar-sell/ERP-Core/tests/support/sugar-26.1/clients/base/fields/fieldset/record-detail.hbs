{{#each fields}}
    <div class="fieldset-field{{#if this.licensed}} hidden{{/if}}" data-type="{{type}}" data-name="{{name}}">
        {{#if ../def.show_child_labels}}
            <div class="record-label ellipsis_inline" title="{{str label ../module}}" data-name="{{name}}">
                {{str label ../module}}
            </div>
        {{/if}}
        {{placeholder}}
    </div>
{{/each}}
