# Built packages. pack.php writes here, CI rebuilds from source on every run
# and uploads the result as a workflow artifact, so a zip in the tree is only
# ever a stale copy of something reproducible - and a stale zip is worse than
# no zip, because it is the thing somebody uploads to an instance.
sugar-sell/*/releases/
sugar-predict/*/releases/

__pycache__/
*.pyc

# The pinned jsdom the real-Sidecar page test runs in: installed from its lock file (npm ci), never committed.
scripts/tests/fixtures/real-sidecar/scripts/tests/dom/node_modules/
